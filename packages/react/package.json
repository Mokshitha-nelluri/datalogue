{
  "name": "datalogue-react",
  "version": "0.1.1",
  "description": "React components for Datalogue — drop-in chat UI and result rendering.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build && pnpm run typecheck"
  },
  "keywords": [
    "react",
    "datalogue",
    "nl2sql",
    "chat",
    "query",
    "database",
    "component"
  ],
  "author": "Mokshitha Nelluri <mokshi.nelluri@gmail.com>",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mokshitha-nelluri/datalogue.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/Mokshitha-nelluri/datalogue#readme",
  "peerDependencies": {
    "datalogue": "^0.1.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}
